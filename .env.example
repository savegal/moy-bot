# Obtain from @BotFather; do not commit or share the real token.
BOT_TOKEN=123456789:REPLACE_WITH_TOKEN
# Your numeric Telegram IDs (can be several admins, comma-separated).
ADMIN_IDS=123456789
DB_PATH=data/bot.sqlite3
HTTP_PORT=8080
POLL_SECONDS=30
# Set to 1 only with a bot token from Telegram's test environment.
# With the default DB_PATH, the test environment uses data/bot-test.sqlite3.
TELEGRAM_TEST_MODE=0

# Enable the CryptoBot checkout button when CRYPTOPAY_TOKEN is configured:
ENABLE_EXTERNAL_PAYMENTS=1

# Optional Crypto Pay (@CryptoBot) adapter:
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=0

# Optional 2328 / 1Fin configuration for reconciliation of existing payments:
GATEWAY_2328_PROJECT=
GATEWAY_2328_KEY=
PUBLIC_BASE_URL=
# Optional custom API base URL for 1Fin / compatible 2328 endpoint:
# GATEWAY_2328_URL=https://api.2328.io/api
